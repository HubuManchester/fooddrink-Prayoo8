<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Theme Settings" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />

            <Label Text="Select app theme:" FontSize="{DynamicResource BodyFontSize}" />
            <Picker x:Name="ThemePicker" Title="Select theme"
                    SelectedIndexChanged="OnThemeChanged"
                    SemanticProperties.Description="Select app theme mode" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Label Text="Accessibility Settings" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Large Font Mode" FontSize="{DynamicResource BodyFontSize}" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="LargeFontSwitch"
                        Toggled="OnLargeFontToggled"
                        SemanticProperties.Hint="Toggle large font mode" />
            </Grid>

            <Label x:Name="FontPreviewLabel" Text="Current font preview size"
                   FontSize="{DynamicResource BodyFontSize}" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />

            <Label Text="About" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />
            <Label Text="Food & Drink Explorer v1.0" FontSize="{DynamicResource BodyFontSize}" />
            <Label Text="Helps you track food nutrition and build healthy eating habits." FontSize="{DynamicResource BodyFontSize}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

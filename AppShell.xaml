<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:maui"
    Title="Food and Drink Explorer">

    <TabBar>
        <ShellContent
            Title="Discover"
            ContentTemplate="{DataTemplate local:MainPage}"
            Icon="dotnet_bot.png"
            Route="MainPage" />
        <ShellContent
            Title="Meal Planner"
            ContentTemplate="{DataTemplate local:MealPlannerPage}"
            Icon="dotnet_bot.png"
            Route="MealPlannerPage" />
        <ShellContent
            Title="Device Tools"
            ContentTemplate="{DataTemplate local:DeviceToolsPage}"
            Icon="dotnet_bot.png"
            Route="DeviceToolsPage" />
    </TabBar>

</Shell>

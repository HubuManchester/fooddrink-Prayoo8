<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:maui"
    Title="食光营养助手">

    <TabBar>
        <ShellContent
            Title="食品"
            ContentTemplate="{DataTemplate local:MainPage}"
            Icon="dotnet_bot.png"
            Route="MainPage" />
        <ShellContent
            Title="膳食计划"
            ContentTemplate="{DataTemplate local:MealPlannerPage}"
            Icon="dotnet_bot.png"
            Route="MealPlannerPage" />
        <ShellContent
            Title="设备工具"
            ContentTemplate="{DataTemplate local:DeviceToolsPage}"
            Icon="dotnet_bot.png"
            Route="DeviceToolsPage" />
        <ShellContent
            Title="设置"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Icon="dotnet_bot.png"
            Route="SettingsPage" />
    </TabBar>

</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.MainPage"
             Title="Discover Food">
    <ScrollView>
        <VerticalStackLayout Padding="18,16" Spacing="14">
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#FFF5E8, Dark=#2E251D}" StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Food and Drink Explorer"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontAttributes="Bold"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Discover cuisines, plan meals, and use device tools to build healthier habits."
                           FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Popular Cuisines"
                   FontSize="{DynamicResource SubTitleFontSize}"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level2" />

            <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🇮🇹 Italian"
                           FontSize="{DynamicResource BodyFontSize}"
                           FontAttributes="Bold" />
                    <Label Text="Fresh tomato, olive oil, basil, and handmade pasta."
                           FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🇯🇵 Japanese"
                           FontSize="{DynamicResource BodyFontSize}"
                           FontAttributes="Bold" />
                    <Label Text="Balanced meals with fish, rice, vegetables, and tea."
                           FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🇲🇽 Mexican"
                           FontSize="{DynamicResource BodyFontSize}"
                           FontAttributes="Bold" />
                    <Label Text="Bold flavors with beans, corn, chili, and citrus."
                           FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Read Today's Nutrition Tip"
                    Clicked="OnReadTipClicked"
                    SemanticProperties.Hint="Reads a health tip aloud using text to speech" />

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label Text="Text Size"
                       FontSize="{DynamicResource BodyFontSize}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       x:Name="TextSizeValueLabel"
                       Text="15"
                       FontSize="{DynamicResource BodyFontSize}" />
            </Grid>

            <Slider x:Name="TextSizeSlider"
                    Minimum="13"
                    Maximum="24"
                    Value="15"
                    ValueChanged="OnTextSizeChanged"
                    SemanticProperties.Description="Adjust app text size for readability" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

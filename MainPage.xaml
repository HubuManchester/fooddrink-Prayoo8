<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.MainPage"
             Title="Food List">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
        <SearchBar x:Name="FoodSearchBar"
                   Placeholder="Search foods, categories, or tags..."
                   SearchButtonPressed="OnSearchButtonPressed"
                   TextChanged="OnSearchTextChanged"
                   SemanticProperties.Hint="Enter keywords to search foods" />

        <RefreshView Grid.Row="1" x:Name="RefreshView"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnFoodSelected"
                            Margin="0,8,0,0">
                <CollectionView.EmptyView>
                    <Label Text="No matching foods found."
                           HorizontalTextAlignment="Center"
                           FontSize="{DynamicResource BodyFontSize}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,10"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}"
                                StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold"
                                           FontSize="{DynamicResource SubTitleFontSize}" />
                                    <Label Grid.Column="1" Text="{Binding Category}"
                                           FontSize="Small" TextColor="Gray" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Description}"
                                       FontSize="{DynamicResource BodyFontSize}"
                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <Label Text="{Binding CaloriesLabel}"
                                           FontSize="Small" TextColor="OrangeRed" />
                                    <Label Grid.Column="1" Text="{Binding MacroSummary}"
                                           FontSize="Small" TextColor="Gray" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="2" Text="Add Food"
                Clicked="OnAddFoodClicked"
                VerticalOptions="End"
                Margin="0,8,0,0"
                SemanticProperties.Hint="Navigate to add food page" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.AddItemPage"
             Title="添加食品">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="新增食品记录" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />

            <Entry x:Name="NameEntry" Placeholder="名称（必填）" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" SemanticProperties.Hint="输入食品名称" />
            <Picker x:Name="CategoryPicker" Title="选择分类（必填）"
                    SemanticProperties.Description="选择食品分类" />
            <Editor x:Name="DescriptionEditor" Placeholder="描述（必填）" AutoSize="TextChanges"
                    MaxLength="200" FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="CaloriesEntry" Placeholder="热量（千卡，必填）" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="ProteinEntry" Placeholder="蛋白质（克）" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="CarbsEntry" Placeholder="碳水化合物（克）" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="FatEntry" Placeholder="脂肪（克）" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="AllergyEntry" Placeholder="过敏提示（可选）" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="TagsEntry" Placeholder="标签，用逗号分隔（可选）" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" />

            <Label x:Name="ValidationLabel" TextColor="OrangeRed" IsVisible="False"
                   FontSize="{DynamicResource BodyFontSize}" />

            <Button Text="保存" Clicked="OnSaveClicked"
                    SemanticProperties.Hint="保存新食品记录" />
            <Button Text="返回" Clicked="OnBackClicked" BackgroundColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

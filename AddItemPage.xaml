<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.AddItemPage"
             Title="Add Food">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="New Food Entry" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />

            <Entry x:Name="NameEntry" Placeholder="Name (required)" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" SemanticProperties.Hint="Enter food name" />
            <Picker x:Name="CategoryPicker" Title="Select Category (required)"
                    SemanticProperties.Description="Select food category" />
            <Editor x:Name="DescriptionEditor" Placeholder="Description (required)" AutoSize="TextChanges"
                    MaxLength="200" FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="CaloriesEntry" Placeholder="Calories (kcal, required)" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="ProteinEntry" Placeholder="Protein (g)" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="CarbsEntry" Placeholder="Carbs (g)" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="FatEntry" Placeholder="Fat (g)" Keyboard="Numeric"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="AllergyEntry" Placeholder="Allergy note (optional)" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" />
            <Entry x:Name="TagsEntry" Placeholder="Tags, comma separated (optional)" ClearButtonVisibility="WhileEditing"
                   FontSize="{DynamicResource BodyFontSize}" />

            <Label x:Name="ValidationLabel" TextColor="OrangeRed" IsVisible="False"
                   FontSize="{DynamicResource BodyFontSize}" />

            <Button Text="Save" Clicked="OnSaveClicked"
                    SemanticProperties.Hint="Save new food entry" />
            <Button Text="Back" Clicked="OnBackClicked" BackgroundColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="maui.FoodDetailPage"
             Title="Food Details">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label x:Name="NameLabel" FontSize="{DynamicResource TitleFontSize}" FontAttributes="Bold" />
            <Label x:Name="CategoryLabel" FontSize="{DynamicResource BodyFontSize}" TextColor="Gray" />

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#FFF5E8, Dark=#2E251D}" StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nutrition Info" FontSize="{DynamicResource SubTitleFontSize}" FontAttributes="Bold" />
                    <Label x:Name="CaloriesLabel" FontSize="{DynamicResource BodyFontSize}" />
                    <Label x:Name="ProteinLabel" FontSize="{DynamicResource BodyFontSize}" />
                    <Label x:Name="CarbsLabel" FontSize="{DynamicResource BodyFontSize}" />
                    <Label x:Name="FatLabel" FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="DescriptionLabel" FontSize="{DynamicResource BodyFontSize}" />

            <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#FFE8E8, Dark=#2E1D1D}" StrokeThickness="0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Allergy Alert" FontAttributes="Bold" FontSize="{DynamicResource BodyFontSize}" />
                    <Label x:Name="AllergyLabel" FontSize="{DynamicResource BodyFontSize}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Read Nutrition Summary" Clicked="OnSpeakClicked"
                    SemanticProperties.Hint="Read food nutrition info aloud" />
            <Button Text="Stop Reading" Clicked="OnStopClicked"
                    SemanticProperties.Hint="Stop current speech playback" />
            <Button Text="Vibrate" Clicked="OnVibrateClicked"
                    SemanticProperties.Hint="Trigger device vibration feedback" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>